NODE_ENV=development
NEXT_PRIVATE_LOCAL_WEBPACK=true

NEXT_PUBLIC_HOST_PORT=4000
NEXT_PUBLIC_REMOTE_PORT=4001

NEXT_PUBLIC_HOST_URL=http://localhost:4000
NEXT_PUBLIC_REMOTE_URL=http://localhost:4001

NODE_SERVER_URL=http://localhost:4010
NODE_SERVER_PORT=4010

# Slack Webhook (Slack 앱 설정에서 발급)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Database (Prisma)
DATABASE_URL=mysql://root:password@localhost:3306/cert_quiz_db

# JWT
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=7d

# AI API
CLAUDE_API_KEY=your-claude-api-key
