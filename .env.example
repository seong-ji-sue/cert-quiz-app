# .env.example — 환경변수 템플릿 (실제값은 .env.local에 저장)
# 복사: cp .env.example .env.local 후 실제 값 입력

# ── 서버 설정 ──────────────────────────────────────
NODE_ENV=development
NEXT_PRIVATE_LOCAL_WEBPACK=true

NEXT_PUBLIC_HOST_PORT=4000
NEXT_PUBLIC_REMOTE_PORT=4001
NODE_SERVER_PORT=4010

NEXT_PUBLIC_HOST_URL=http://localhost:4000
NEXT_PUBLIC_REMOTE_URL=http://localhost:4001
NODE_SERVER_URL=http://localhost:4010

# ── 데이터베이스 (Prisma) ───────────────────────────
DATABASE_URL=mysql://root:password@localhost:3306/cert_quiz_db

# ── 인증 ───────────────────────────────────────────
JWT_SECRET=your-jwt-secret-key-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── AI 모델 API ─────────────────────────────────────
# Claude (Anthropic) — 핵심 AI: 해설 생성, 코드 리뷰
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Gemini (Google) — UI/UX 분석, OCR 보정, 이미지 처리
GOOGLE_API_KEY=AIza-your-key-here
GEMINI_MODEL=gemini-1.5-pro

# Grok (xAI) — 트렌드 분석, 아키텍처 리뷰
XAI_API_KEY=xai-your-key-here
GROK_MODEL=grok-3

# AI 비용 알림 (일일 USD 임계값)
AI_COST_ALERT_THRESHOLD=5.00

# ── 알림 ───────────────────────────────────────────
# Slack Incoming Webhook (앱 설정: https://api.slack.com/apps)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── 캐시 ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── comcbt 크롤러 ───────────────────────────────────
CRAWLER_RATE_LIMIT_MS=3000    # 요청 간격 (ms), comcbt 서버 보호
CRAWLER_MAX_RETRIES=3
